# APIs Gratuitas (usadas por defecto - sin API key)
# - OpenMeteo: completamente gratis, sin API key
# - MetNorway: completamente gratis
# - 7Timer: completamente gratis (NOAA based)
# - Wttr.in: completamente gratis
# - WeatherDB: completamente gratis
# - INUMET: gratis para Uruguay
# - US-NWS: gratis para USA
# - ECCC: gratis para Canada

# APIs Opcionales (necesitan API key)
OPENWEATHER_API_KEY=tu_api_key_aqui
WEATHERAPI_KEY=tu_api_key_aqui
PIRATE_WEATHER_API_KEY=tu_api_key_aqui
TOMORROW_IO_API_KEY=tu_api_key_aqui

# Nuevas Fuentes Gratuitas/Paid
VISUAL_CROSSING_KEY=tu_api_key_aqui        # Free tier disponible en visualcrossing.com
STORM_GLASS_KEY=tu_api_key_aqui           # Free tier en stormglass.io
WEATHER2020_KEY=tu_api_key_aqui           # Free tier en weather2020.com
AEMET_API_KEY=tu_api_key_aqui             # Spain - aemet.es

# IA Options
OLLAMA_URL=http://localhost:11434
GROQ_API_KEY=tu_api_key_aqui              # Free en console.groq.com
DEEPSEEK_API_KEY=tu_api_key_aqui          # Free tier en platform.deepseek.com

# Server
PORT=3001
